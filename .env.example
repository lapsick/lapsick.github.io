# Public Formspree endpoint from your form's Integration tab.
# Copy to .env and replace with your own endpoint. This is a public form URL,
# not an API key. Leave empty to show direct email/LinkedIn contact links only.
PUBLIC_FORMSPREE_ENDPOINT=

# Optional hosted GoatCounter collection endpoint (public, not a secret).
# Example: https://your-account.goatcounter.com/count
# Leave empty to disable analytics. Restart/rebuild after changing it.
PUBLIC_GOATCOUNTER_ENDPOINT=
