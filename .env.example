# SMTP transport for the contact form (src/lib/mail.ts).
# Copy this file to .env and fill in real values. Never commit .env.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Must be a mailbox on a domain you control (SPF/DKIM configured) —
# never the visitor's address. See specs/001-portfolio-blog-site/research.md (R3).
SMTP_FROM="Portfolio Contact <noreply@your-domain.example>"

# Destination inbox for contact-form submissions.
CONTACT_TO_EMAIL=you@your-domain.example

# Shown to the visitor if delivery fails.
PUBLIC_FALLBACK_EMAIL=you@your-domain.example
