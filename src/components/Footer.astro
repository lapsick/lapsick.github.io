---
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; {new Date().getFullYear()} {profile.name}</p>
    <div class="site-footer__right">
      <ul class="site-footer__links">
        <li>
          <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
        <li>
          <a href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
      <img
        class="site-footer__badge"
        src="/images/glory-to-ukraine-2.png"
        alt="Glory To Ukraine! | Слава Україні!"
        title="Glory to Heros!"
        width="150"
        height="180"
      />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .site-footer__badge {
    display: block;
    height: 40px;
    width: auto;
    border-radius: 4px;
  }
</style>
