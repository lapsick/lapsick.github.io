---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/community', label: 'Community' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <div class="site-nav__brand-group">
      <svg
        class="site-nav__flag"
        viewBox="0 0 3 2"
        width="24"
        height="16"
        role="img"
        aria-label="Flag of Ukraine"
      >
        <title>Glory to Ukraine!</title>
        <rect width="3" height="1" fill="#0057B7"></rect>
        <rect width="3" height="1" y="1" fill="#FFD700"></rect>
      </svg>
      <a class="site-nav__brand" href="/">To Boldly Ship Where No One Has Shipped Before.</a>
    </div>
    <nav aria-label="Primary">
      <ul class="site-nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-3);
  }

  .site-nav__brand-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-nav__flag {
    flex-shrink: 0;
    display: block;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .site-nav__brand {
    font-weight: 600;
    font-size: clamp(0.85rem, 2.2vw, 1rem);
    text-decoration: none;
    color: var(--color-text);
    max-width: 32rem;
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__links a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
  }

  .site-nav__links a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
