---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const typeLabels: Record<string, string> = {
  talk: 'Talk',
  article: 'Article',
  podcast: 'Podcast',
  conference: 'Attended',
  course: 'Course',
  other: 'Other',
};

const sorted = [...profile.communityEvents].sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---

<BaseLayout
  title={`Community & Learning — ${profile.name}`}
  description={`Conferences, courses, and talks ${profile.name} has been part of.`}
>
  <div class="container prose" style="padding-block: var(--space-6);">
    <h1>Community & Learning</h1>
    <p>
      Conferences and courses I've taken part in, plus any talks or writing beyond the{' '}
      <a href="/blog">blog</a>.
    </p>

    {
      sorted.length === 0 ? (
        <p class="events-empty">Nothing to show here yet.</p>
      ) : (
        <ul class="events-list">
          {sorted.map((item) => (
            <li>
              <span class="events-list__type">{typeLabels[item.type]}</span>
              <h2>
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h2>
              <p class="events-list__meta">
                {item.location}
                {item.location && item.date && ' · '}
                {item.date}
              </p>
              {item.description && <p>{item.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .events-empty {
    color: var(--color-text-muted);
    padding-block: var(--space-4);
  }

  .events-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .events-list li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .events-list h2 {
    margin: var(--space-1) 0;
    font-size: 1.1rem;
  }

  .events-list__type {
    display: inline-block;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .events-list__meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 var(--space-2);
  }
</style>
