---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { profile } from '../data/profile';

const endpoint = (import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '').trim();
if (endpoint && !/^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(endpoint)) {
  throw new Error('PUBLIC_FORMSPREE_ENDPOINT must be https://formspree.io/f/<form-id>');
}
---

<BaseLayout
  title={`Contact — ${profile.name}`}
  description={`Get in touch with ${profile.name} about roles, collaboration, or questions.`}
>
  <div class="container prose" style="padding-block: var(--space-6);">
    <h1>Contact</h1>
    <p>
      Get in touch about roles, collaboration, or questions.
      Email <a href={`mailto:${profile.email}`}>{profile.email}</a>
      or connect on <a href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
    {endpoint ? (
      <ContactForm endpoint={endpoint} />
    ) : (
      <p>The contact form is currently unavailable. Please use email or LinkedIn above.</p>
    )}
  </div>
</BaseLayout>
