---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { profile } from '../data/profile';

// Must be server-rendered, not prerendered: it reads a per-request flash
// cookie and the ?sent=1 query param, neither of which exist at build time.
// FR-006 excepts the contact page from the static-only rule for this reason.
export const prerender = false;

const FLASH_COOKIE = 'contact_flash';

interface FlashPayload {
  values?: { name?: string; email?: string; company?: string; message?: string };
  errors?: Record<string, string>;
  submitFailed?: boolean;
}

let flash: FlashPayload = {};
const flashCookie = Astro.cookies.get(FLASH_COOKIE);
if (flashCookie) {
  try {
    flash = JSON.parse(flashCookie.value);
  } catch {
    flash = {};
  }
  Astro.cookies.delete(FLASH_COOKIE, { path: '/' });
}

const sent = Astro.url.searchParams.get('sent') === '1';
---

<BaseLayout
  title={`Contact — ${profile.name}`}
  description={`Get in touch with ${profile.name} about roles, collaboration, or questions.`}
>
  <div class="container prose" style="padding-block: var(--space-6);">
    <h1>Contact</h1>

    {
      sent && (
        <p class="form-status form-status--success" role="status">
          Thanks — your message has been sent.
        </p>
      )
    }

    {
      !sent && (
        <ContactForm
          values={flash.values}
          errors={flash.errors}
          submitFailed={flash.submitFailed}
          fallbackEmail={profile.email}
        />
      )
    }
  </div>
</BaseLayout>
